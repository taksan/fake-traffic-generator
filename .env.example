# Port mappings for fake-traffic-generator services
# These are the host ports that will be mapped to the container ports

# Traffic Generator API port (default: 8000)
TRAFFIC_GENERATOR_PORT=8000

# User Database API port (default: 8500)
USER_DATABASE_PORT=8500

# Server Assignment API port (default: 8600)
SERVER_ASSIGNMENT_PORT=8600

# Network configuration (default: fake-traffic-generator)
NETWORK_NAME=fake-traffic-generator

# Configuration files (optional, defaults to files in current directory)
# USER_FLOWS_FILE=./user_flows.yml
# GEO_SERVERS_FILE=./geo_servers.geojson

# Logging configuration (optional, uses json-file driver by default)
# Both Grafana/Loki and ELK stacks use json-file driver with these options
# LOGGING_DRIVER=json-file
# LOGGING_MAX_SIZE=10m
# LOGGING_MAX_FILE=3
# LOGGING_LABELS=container,service

# Service URLs (for inter-service communication)
USER_DB_URL=http://user-database:8500
SERVER_ASSIGNMENT_URL=http://server-assignment:8600
